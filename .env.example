# DevOps Agent 的 Agent Space ID(在控制台 Agent Space 详情页可见)
AGENT_SPACE_ID=your-agent-space-id

# 用于调用的 AWS profile(~/.aws/credentials 中的条目)。留空则走默认凭证链。
AWS_PROFILE=default

# DevOps Agent 所在区域
DEVOPS_AGENT_REGION=us-east-1

# 后端端口
PORT=3001

# --- Operator 角色(可选，但推荐) ---
# 配置后，后端用 AWS_PROFILE 去 assume 此角色并注入 AgentSpaceId session tag，
# 与控制台 "Operator access" 入口同款身份 —— 自建 UI 创建的会话标准 Web UI 也能看到。
# 角色 ARN 形如 arn:aws:iam::<account>:role/service-role/DevOpsAgentRole-WebappAdmin-xxxxxxx
# (在控制台 DevOps Agent → Settings → Operator access 的 "IAM Role for administrator access" 处可见)
# 留空则退回直接使用 AWS_PROFILE(会话仅自建 UI 可见，标准 Web UI 看不到)。
DEVOPS_OPERATOR_ROLE_ARN=
DEVOPS_OPERATOR_SESSION_NAME=devops-agent-ui
DEVOPS_OPERATOR_SESSION_DURATION=3600
